# ─────────────────────────────────────────────────────────────────────────────
# E-Commerce Microservices — Environment Configuration
# Copy this file to .env and fill in real values before running docker-compose.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DB_USERNAME=app_user
DB_PASSWORD=changeme

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASS=changeme

# ── Internal service-to-service auth ─────────────────────────────────────────
# Shared secret header for intra-cluster calls (X-Internal-API-Key).
# Gateway strips this header from all external requests.
INTERNAL_API_KEY=changeme-internal-key

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# In dev, MailHog captures all outbound email (no real SMTP needed).
# In production, replace with real SMTP credentials.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ── Anthropic (MCP Server) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Keycloak Identity Provider ────────────────────────────────────────────────
# Admin credentials for the Keycloak master realm (manage the admin UI).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── MCP Server — OAuth2 Client Credentials ───────────────────────────────────
# Must match the "mcp-server" client secret in infrastructure/keycloak/ecommerce-realm.json.
# Also set in claude_desktop_config.json (env block for the ecommerce MCP entry).
# ⚠️  Never commit claude_desktop_config.json to version control.
MCP_CLIENT_SECRET=changeme-mcp-secret

# ── Google Sign-In (optional — configure via Keycloak Admin UI) ───────────────
# After Keycloak starts, go to:
#   http://localhost:8180 → Realm: ecommerce → Identity Providers → Add → Google
# Paste your Google Client ID and Secret there. No code changes required.
# Get Client ID from: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
